def say(case, speaker, line):
    """Print one line of dialogue or narration."""
    text = line.format(doctor=doctor, complaint=case["chief_complaint"])
    if speaker:
        print(f"\n{speaker}: {text}")
    else:
        print(f"\n{text}")


def pick(title, labels, back_label):
    """Show a numbered menu. Returns the chosen index, or None if the player chose to go back."""
    while True:
        print(f"\n{title}")
        for number, label in enumerate(labels, start=1):
            print(f"{number}. {label}")
        print(f"0. {back_label}")
        choice = input("Enter a number: ").strip()
        if choice == "0":
            return None
        if choice.isdigit() and 1 <= int(choice) <= len(labels):
            return int(choice) - 1
        print("\nInvalid input")


def check_case(case):
    """Catch common template mistakes before the game starts."""
    options = case["diagnosis"]["options"]
    correct_count = sum(1 for option in options if option["correct"])
    if correct_count != 1:
        raise ValueError(f"Case '{case['title']}': the diagnosis list needs exactly ONE option with correct=True (found {correct_count}).")
    if not isinstance(case["age_years"], (int, float)):
        raise ValueError(f"Case '{case['title']}': age_years must be a number, like 12 or 0.5.")


def vitals_menu(case):
    items = case["vitals"]
    while True:
        index = pick("Which vital would you like to assess?",
                     [v["label"] for v in items], "Return to Beginning")
        if index is None:
            return
        say(case, None, items[index]["action"])
        say(case, None, items[index]["result"])


def history_menu(case):
    items = case["history"]
    while True:
        index = pick("What would you like to ask about?",
                     [h["label"] for h in items],
                     "You're done asking about medical history for now")
        if index is None:
            return
        say(case, None, items[index]["action"])
        for speaker, line in items[index]["responses"]:
            say(case, speaker, line)


def exam_menu(case):
    regions = case["exam"]
    names = list(regions.keys())
    while True:
        index = pick("Where would you like to examine first?", names,
                     "You have concluded your physical examination")
        if index is None:
            return
        region = regions[names[index]]
        if region["overview"]:
            say(case, None, region["overview"])
        parts = region["parts"]
        while True:
            part_index = pick(f"What would you like to observe? ({names[index]})",
                              [p["label"] for p in parts],
                              "Examine something else for now")
            if part_index is None:
                break
            say(case, None, parts[part_index]["action"])
            say(case, None, parts[part_index]["result"])


def diagnosis_lookup_menu(case):
    """Dictionary section: look up the possible diagnoses, alphabetically."""
    entries = sorted(case["diagnosis"]["options"], key=lambda option: option["name"].lower())
    while True:
        index = pick("Which diagnosis would you like to look up?",
                     [entry["name"] for entry in entries], "Back to the dictionary")
        if index is None:
            return
        say(case, None, f"{entries[index]['name']}: {entries[index]['description']}")


def baseline_for_age(age):
    for group in BASELINES:
        if group["min_age"] <= age < group["max_age"]:
            return group
    return None


def baseline_menu(case):
    """Dictionary section: healthy vitals for pediatric and adult patients."""
    patient_group = baseline_for_age(case["age_years"])
    labels = []
    for group in BASELINES:
        marker = "  <- your patient's age group" if group is patient_group else ""
        labels.append(group["group"] + marker)
    while True:
        index = pick("Healthy vitals reference. Which age group?", labels, "Back to the dictionary")
        if index is None:
            return
        group = BASELINES[index]
        print(f"\nHealthy vitals: {group['group']}")
        print(f"  Blood pressure: {group['bp']}")
        print(f"  Heart rate:     {group['hr']}")
        print(f"  Respiration:    {group['rr']}")
        print(f"  Glucose:        {group['glucose']}")


def dictionary_menu(case):
    """Medical Dictionary: diagnoses and the healthy vitals reference."""
    print("\nWelcome to the Medical Dictionary!")
    while True:
        index = pick("What would you like to look up?",
                     ["Diagnoses", "Healthy vitals reference"], "Return to the exam")
        if index is None:
            return
        [diagnosis_lookup_menu, baseline_menu][index](case)


def diagnosis_menu(case):
    """Returns the diagnosis option the player submitted, or None if they went back to the exam."""
    diagnosis = case["diagnosis"]
    options = diagnosis["options"]
    while True:
        index = pick(diagnosis["prompt"], [o["name"] for o in options],
                     "Go back and gather more information")
        if index is None:
            return None
        option = options[index]
        confirm = pick(f"Submit '{option['name']}' as your final diagnosis? You can't change it.",
                       ["Yes, submit this diagnosis"], "No, let me choose again")
        if confirm is None:
            continue
        for speaker, line in option["response"]:
            say(case, speaker, line)
        return option


def run_case(case):
    """Play one case. Returns the diagnosis option the player submitted."""
    for speaker, line in case["intro"]:
        say(case, speaker, line)
    while True:
        index = pick("What do you want to do first?",
                     ["Check Vitals",
                      "Ask about past medical history",
                      "Start a physical exam",
                      "Check medical dictionary"],
                     "Finish the exam and make a diagnosis")
        if index is None:
            chosen = diagnosis_menu(case)
            if chosen is not None:
                return chosen
            continue
        [vitals_menu, history_menu, exam_menu, dictionary_menu][index](case)


def show_tally(results):
    """results maps case number -> the diagnosis option the player submitted."""
    right = sum(1 for option in results.values() if option["correct"])
    wrong = len(results) - right
    not_seen = len(ALL_CASES) - len(results)
    print("\n" + "=" * 44)
    print("END OF DAY SUMMARY")
    print("=" * 44)
    print(f"Correct diagnoses:   {right}")
    print(f"Incorrect diagnoses: {wrong}")
    if not_seen:
        print(f"Patients not seen:   {not_seen}")
    for number in sorted(results):
        case = ALL_CASES[number]
        option = results[number]
        verdict = "Correct" if option["correct"] else "Incorrect"
        print(f"\nCase {number + 1} ({case['patient_name']}): you chose {option['name']} - {verdict}")
        if not option["correct"]:
            answer = next(o for o in case["diagnosis"]["options"] if o["correct"])
            print(f"  Correct diagnosis: {answer['name']}")


def main():
    for case in ALL_CASES:
        check_case(case)
    results = {}
    while True:
        if len(results) == len(ALL_CASES):
            print("\nYou've seen all of today's patients.")
            break
        labels = []
        for number, case in enumerate(ALL_CASES):
            suffix = " (diagnosed)" if number in results else ""
            labels.append(f"Case {number + 1}: {case['title']}{suffix}")
        index = pick("Which patient would you like to see?", labels, "Leave the clinic and see your results")
        if index is None:
            break
        if index in results:
            print("\nYou've already made a final diagnosis for this patient.")
            continue
        results[index] = run_case(ALL_CASES[index])
    show_tally(results)


doctor = input("What is your name, Doctor? ")
main()
